{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!.next",
      "!.next-*",
      "!tsconfig.json",
      "!test-results",
      "!node_modules",
      "!docs",
      "!.source",
      "!sdks",
      "!fern/openapi",
      "!content",
      "!next-env.d.ts",
      "!supabase/.temp",
      "!supabase/.branches",
      "!lib/db/types.ts",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true
  }
}
