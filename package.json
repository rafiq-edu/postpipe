{
  "name": "postit",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env.local --import ./scripts/register-ts.mjs worker.ts",
    "test:integration": "INTEGRATION=1 vitest run tests/integration",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "biome check .",
    "load:test": "node --env-file-if-exists=.env.local --import ./scripts/register-ts.mjs scripts/load-test.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local --schema public > lib/db/types.ts",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "env:local": "bash scripts/env-local.sh",
    "docs:sync": "node --import ./scripts/register-ts.mjs scripts/sync-platform-docs.ts",
    "sdk:generate": "node --import ./scripts/register-ts.mjs scripts/export-openapi.ts && fern generate --local --group typescript && fern generate --local --group python"
  },
  "dependencies": {
    "@atproto/oauth-client-node": "^0.5.13",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/cloudfront-signer": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@polar-sh/sdk": "^1.0.2",
    "@sentry/nextjs": "^11.9.0",
    "@sentry/node": "^11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.17.2",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-openapi": "12.4.2",
    "fumadocs-ui": "16.17.2",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "^2.71.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fern-api": "5.157.0",
    "msw": "^3.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
